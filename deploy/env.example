# Production settings for deploy/compose.yml. On a single server (staging, P7-1), deploy/single/init-env.sh writes
# all of these, plus postgres.env, with fresh secrets: docs/staging-runbook.md. Elsewhere, put the sections into
# app.env, release.env and so on, on the host (or the provider's secret store). Never commit filled-in copies.
# Generate random values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Start-up refuses unsafe values: http origins, debug logging, placeholder keys, a database role that row-level
# security does not bind.

# ===== app.env: the API's runtime settings =====
# The restricted application role (created by "db provision"), never the database owner. Use TLS to a managed
# database, e.g. ?sslmode=verify-full with the provider's CA.
DATABASE_URL=postgres://innpilot_app:<APP_DB_PASSWORD>@<db-host>:5432/innpilot?sslmode=require
# The public origin, https only.
WEB_ORIGINS=https://<host>
COOKIE_SECURE=true
MFA_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOG_LEVEL=info
JOBS_POLL_SECONDS=5
# Optional: where scrubbed error reports are also posted (an error-tracking ingest URL or a team webhook), https.
# ERROR_WEBHOOK_URL=
# (METRICS_PORT is set to 9464 by compose.yml: the internal port Prometheus scrapes.)
# The provider's private S3-compatible bucket, with credentials limited to that bucket. Plain http is accepted
# only for a service on the private network (a single-label host name).
STORAGE_ENDPOINT=https://<storage-endpoint>
STORAGE_REGION=<region>
STORAGE_BUCKET=<bucket>
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ===== release.env: release steps only (backup, migrations, first-time provisioning) =====
# The database owner. Only the release services read this file; the running API never sees it.
DATABASE_ADMIN_URL=postgres://<owner>:<password>@<db-host>:5432/innpilot?sslmode=require
# Needed only for "db provision" (first set-up, or rotating the application role's password).
APP_DB_PASSWORD=

# ===== backup.env: nightly encrypted backups (docs/backup-and-restore.md) =====
# A bucket in a separate account or project from the application's storage, credentials limited to it.
BACKUP_STORAGE_ENDPOINT=https://<backup-storage-endpoint>
BACKUP_STORAGE_REGION=<region>
BACKUP_BUCKET=<backup-bucket>
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
# From "node dist/ops/cli.js keygen". Only the PUBLIC key goes here; keep BACKUP_PRIVATE_KEY offline.
BACKUP_PUBLIC_KEY=
# Nightly backup time in UTC (21:00 UTC is 02:00 in Pakistan).
BACKUP_AT_UTC=21:00

# ===== monitoring.env: the monitoring profile (docs/incident-response.md) =====
# A long random value; without it Grafana falls back to admin/admin.
GF_SECURITY_ADMIN_PASSWORD=
