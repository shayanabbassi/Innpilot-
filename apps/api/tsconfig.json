{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "outDir": "dist",
    "rootDir": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "isolatedModules": false,
    "types": ["node"]
  },
  "include": [
    "src",
    "test",
    "perf",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "vitest.perf.config.ts"
  ]
}
