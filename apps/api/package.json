{
  "name": "@innpilot/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test perf load",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "openapi": "tsx src/openapi/write.ts",
    "platform:operator": "tsx --env-file-if-exists=../../.env src/platform/create-operator.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@innpilot/contracts": "workspace:*",
    "@innpilot/db": "workspace:*",
    "@innpilot/money": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.3",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.12"
  }
}
