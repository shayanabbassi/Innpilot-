# Copy to .env and fill in local values. Never commit .env.
# Generate random values, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Local Postgres container (docker compose) ---
POSTGRES_PASSWORD=

# --- Database connections ---
# Migrator / provisioning connection (table owner). Locally: the container superuser.
DATABASE_ADMIN_URL=postgres://postgres:<POSTGRES_PASSWORD>@localhost:5432/innpilot
# Password for the restricted application role `innpilot_app` (created by `pnpm db:provision`).
APP_DB_PASSWORD=
# Application connection (restricted role, subject to row-level security).
DATABASE_URL=postgres://innpilot_app:<APP_DB_PASSWORD>@localhost:5432/innpilot

# --- API ---
API_PORT=4000
# Browser origins allowed to call the API (comma-separated). Used for CORS and CSRF Origin checks.
WEB_ORIGINS=http://localhost:3000
# true in any deployed environment (requires HTTPS); false only for local http development.
COOKIE_SECURE=false
# 32 random bytes, base64url. Encrypts TOTP secrets at rest. Rotating it invalidates enrolled MFA.
MFA_ENCRYPTION_KEY=
# 32 random bytes, base64url. Encrypts guest identity-document numbers. Must differ from MFA_ENCRYPTION_KEY.
# Losing it makes stored document numbers unreadable; rotating it needs a re-encryption job.
PII_ENCRYPTION_KEY=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOG_LEVEL=info
# Background jobs (exports prepared in the background, file clean-up): how often this instance looks for work,
# in seconds. 0 turns the worker off on an instance that should only serve requests. Several instances may run it.
JOBS_POLL_SECONDS=5

# --- Development seed (pnpm db:seed) ---
# Password given to every fictional demo user. At least 12 characters.
SEED_USER_PASSWORD=

# --- Web ---
# Where the Next.js dev server proxies /api requests.
API_INTERNAL_URL=http://localhost:4000

# --- Object storage (attachments) ---
# Any S3-compatible service. Locally: the `storage` container in docker-compose.yml (Versity S3 Gateway).
# In a deployed environment: the provider's private bucket over https, with credentials limited to that bucket.
STORAGE_ENDPOINT=http://localhost:7070
STORAGE_REGION=us-east-1
STORAGE_BUCKET=innpilot-dev
# Random values locally; the container is created with them.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
